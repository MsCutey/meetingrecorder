<Window x:Class="MeetingRecorder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MeetingRecorder.Core.Models;assembly=MeetingRecorder.Core"
        Title="MeetingRecorder · 会议录屏"
        Icon="Assets/MeetingRecorder.ico"
        Width="1220" Height="840" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="76" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="90" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#121826">
      <Grid Margin="26,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="42" Height="42" CornerRadius="11" Background="Transparent" VerticalAlignment="Center">
          <Image Source="Assets/MeetingRecorder.png" Stretch="Uniform" SnapsToDevicePixels="True" />
        </Border>
        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="MeetingRecorder" Foreground="White" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="本地会议录屏 · 清晰可见地录制" Foreground="#98A2B3" FontSize="12" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="9" Height="9" Margin="0,0,8,0">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="#667085" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding State}" Value="{x:Static models:RecordingState.Recording}"><Setter Property="Fill" Value="#FF4D4F" /></DataTrigger>
                  <DataTrigger Binding="{Binding State}" Value="{x:Static models:RecordingState.Paused}"><Setter Property="Fill" Value="#FDB022" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding StatusText}" Foreground="#EAECF0" FontSize="13" VerticalAlignment="Center" />
          <Button Content="⚙ 设置" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource SoftButtonStyle}" Padding="12,6" Click="OpenSettingsClick" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#FFF4E5" BorderBrush="#FEC84B" BorderThickness="0,0,0,1"
            Visibility="{Binding HasRecoveries, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid Margin="28,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding RecoveryBannerText}" Foreground="#7A2E0E" FontWeight="SemiBold" VerticalAlignment="Center" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding RecoveryCandidates}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="恢复文件" Margin="8,0,0,0" Style="{StaticResource SoftButtonStyle}"
                      Command="{Binding DataContext.RecoverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Grid.Column="2" Content="✕" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SoftButtonStyle}" Padding="10,5"
                ToolTip="本次会话内不再提醒" Command="{Binding DismissRecoveryCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="24,20,24,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.08*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="0.92*" />
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource CardStyle}">
            <StackPanel IsEnabled="{Binding IsEditingEnabled}">
              <TextBlock Text="录制模式" Style="{StaticResource SectionTitleStyle}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="9" BorderThickness="1" BorderBrush="#D0D5DD" Padding="14">
                  <RadioButton GroupName="Mode" VerticalContentAlignment="Center"
                               IsChecked="{Binding SelectedMode, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=VideoAndAudio}">
                    <StackPanel Margin="8,0,0,0">
                      <TextBlock Text="视频 + 声音" FontWeight="SemiBold" Foreground="#1D2939" />
                      <TextBlock Text="MP4 · H.264 / AAC" Foreground="#667085" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                  </RadioButton>
                </Border>
                <Border Grid.Column="2" CornerRadius="9" BorderThickness="1" BorderBrush="#D0D5DD" Padding="14">
                  <RadioButton GroupName="Mode" VerticalContentAlignment="Center"
                               IsChecked="{Binding SelectedMode, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=AudioOnly}">
                    <StackPanel Margin="8,0,0,0">
                      <TextBlock Text="仅声音" FontWeight="SemiBold" Foreground="#1D2939" />
                      <TextBlock Text="M4A · AAC 128 kbps" Foreground="#667085" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                  </RadioButton>
                </Border>
              </Grid>
              <TextBlock Text="{Binding ModeDescription}" Foreground="#667085" FontSize="12" Margin="2,11,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsVideoMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel IsEnabled="{Binding IsEditingEnabled}">
              <Grid Margin="0,0,0,12">
                <TextBlock Text="画面来源" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                <Button HorizontalAlignment="Right" Content="↻ 刷新" Style="{StaticResource SoftButtonStyle}" Padding="10,5" Command="{Binding RefreshDevicesCommand}" />
              </Grid>
              <ComboBox ItemsSource="{Binding CaptureTargets}" SelectedItem="{Binding SelectedTarget}" />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="画质" Foreground="#475467" FontSize="12" Margin="0,0,0,5" />
                  <ComboBox ItemsSource="{Binding QualityChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SelectedQuality}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="帧率" Foreground="#475467" FontSize="12" Margin="0,0,0,5" />
                  <TextBox Text="30 fps（固定）" IsReadOnly="True" Background="#F9FAFB" />
                </StackPanel>
              </Grid>
              <CheckBox Margin="0,14,0,0"
                        Content="整屏录制时隐藏 MeetingRecorder（实验性）"
                        IsChecked="{Binding ExcludeMainWindowFromDisplayCapture}"
                        IsEnabled="{Binding IsDisplayCaptureSelected}" />
              <TextBlock Text="默认关闭。启用后任务栏预览可能变黑，部分电脑录制期间可能暂时看不到主窗口。"
                         TextWrapping="Wrap" Foreground="#667085" FontSize="11" Margin="24,5,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel IsEnabled="{Binding IsEditingEnabled}">
              <TextBlock Text="声音来源" Style="{StaticResource SectionTitleStyle}" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition /><ColumnDefinition Width="74" /></Grid.ColumnDefinitions>
                <CheckBox Content="系统声音" IsChecked="{Binding CaptureSystemAudio}" />
                <ComboBox Grid.Column="1" Margin="8,0" ItemsSource="{Binding SystemAudioDevices}" SelectedItem="{Binding SelectedSystemAudioDevice}" IsEnabled="{Binding CaptureSystemAudio}" />
                <ProgressBar Grid.Column="2" Height="8" Maximum="100" Value="{Binding SystemAudioLevel, Mode=OneWay}" VerticalAlignment="Center" Foreground="#12B76A" Background="#EAECF0" />
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="118" /><ColumnDefinition /><ColumnDefinition Width="74" /></Grid.ColumnDefinitions>
                <CheckBox Content="麦克风" IsChecked="{Binding CaptureMicrophone}" />
                <ComboBox Grid.Column="1" Margin="8,0" ItemsSource="{Binding MicrophoneDevices}" SelectedItem="{Binding SelectedMicrophoneDevice}" IsEnabled="{Binding CaptureMicrophone}" />
                <ProgressBar Grid.Column="2" Height="8" Maximum="100" Value="{Binding MicrophoneLevel, Mode=OneWay}" VerticalAlignment="Center" Foreground="#2E90FA" Background="#EAECF0" />
              </Grid>
              <TextBlock Text="系统声音会收录所选扬声器上的全部声音；设备短暂断开时保留时间轴。" TextWrapping="Wrap" Foreground="#667085" FontSize="11" Margin="0,12,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}">
            <StackPanel IsEnabled="{Binding IsEditingEnabled}">
              <TextBlock Text="保存与控制" Style="{StaticResource SectionTitleStyle}" />
              <TextBlock Text="输出目录" Foreground="#475467" FontSize="12" Margin="0,0,0,5" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding OutputDirectory}" IsReadOnly="True" />
                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource SoftButtonStyle}" Command="{Binding BrowseOutputCommand}" />
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="开始 / 停止" Foreground="#475467" FontSize="12" Margin="0,0,0,5" />
                  <TextBox Text="{Binding StartStopHotKey, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="暂停 / 恢复" Foreground="#475467" FontSize="12" Margin="0,0,0,5" />
                  <TextBox Text="{Binding PauseResumeHotKey, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="倒计时（秒）" Foreground="#475467" FontSize="12" Margin="0,0,0,5" />
                  <ComboBox ItemsSource="{Binding CountdownChoices}" SelectedItem="{Binding CountdownSeconds}" />
                </StackPanel>
              </Grid>
              <Grid Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="麦克风开关" Foreground="#475467" FontSize="12" Margin="0,0,0,5" />
                  <TextBox Text="{Binding MicToggleHotKey, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding StorageModeText}" Foreground="#98A2B3" FontSize="11" Margin="0,11,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0" Padding="0" ClipToBounds="True">
          <Grid Height="280" Background="#111827">
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers><DataTrigger Binding="{Binding HasPreview}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="▣" Foreground="#475467" FontSize="38" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding PreviewPlaceholderText}" Foreground="#98A2B3" FontSize="12" Margin="0,8,0,0" />
              <TextBlock Text="仅声音模式不会访问真实屏幕" Foreground="#667085" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
            <Border VerticalAlignment="Bottom" Background="#D9101826" Padding="15,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="时长" Foreground="#98A2B3" FontSize="10" /><TextBlock Text="{Binding ElapsedText}" Foreground="White" FontSize="16" FontFamily="Consolas" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="文件" Foreground="#98A2B3" FontSize="10" /><TextBlock Text="{Binding FileSizeText}" Foreground="White" FontSize="14" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="剩余磁盘约" Foreground="#98A2B3" FontSize="10" /><TextBlock Text="{Binding DiskTimeText}" Foreground="White" FontSize="14" /></StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="18,0">
              <TextBlock Text="录制历史" FontSize="15" FontWeight="SemiBold" Foreground="#172033" VerticalAlignment="Center" />
              <Button Content="打开目录" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SoftButtonStyle}" Padding="10,5" Command="{Binding OpenOutputCommand}" />
            </Grid>
            <ListView Grid.Row="1" ItemsSource="{Binding History}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="10,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#344054" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding StartedText}" Foreground="#98A2B3" FontSize="11" />
                        <TextBlock Text="  ·  " Foreground="#D0D5DD" />
                        <TextBlock Text="{Binding ModeText}" Foreground="#667085" FontSize="11" />
                        <TextBlock Text="  ·  " Foreground="#D0D5DD" />
                        <TextBlock Text="{Binding DurationText}" Foreground="#667085" FontSize="11" />
                        <TextBlock Text="  ·  " Foreground="#D0D5DD" />
                        <TextBlock Text="{Binding SizeText}" Foreground="#667085" FontSize="11" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                      <Button Content="查看" VerticalAlignment="Center" Style="{StaticResource SoftButtonStyle}" Padding="9,5"
                              Command="{Binding DataContext.OpenHistoryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                      <Button Content="删除" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SoftButtonStyle}" Padding="9,5"
                              Command="{Binding DataContext.DeleteHistoryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="3" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0">
      <Grid Margin="24,13">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding WarningText}" Foreground="#B42318" FontWeight="SemiBold" TextWrapping="Wrap"
                     Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <TextBlock Text="录制状态始终清晰显示。请在录制前取得所有参会者授权。" Foreground="#667085" FontSize="12" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding MicToggleButtonText}" Margin="0,0,10,0" Style="{StaticResource SoftButtonStyle}" Padding="14,13"
                  Command="{Binding MicToggleCommand}"
                  ToolTip="录制中随时开关麦克风；未启用麦克风的录制不可切换" />
          <Button Content="{Binding PauseButtonText}" Margin="0,0,10,0" Style="{StaticResource SoftButtonStyle}" Padding="22,13" Command="{Binding PauseResumeCommand}" />
          <Button Content="{Binding PrimaryButtonText}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding PrimaryCommand}" MinWidth="170" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Panel.ZIndex="10" Grid.RowSpan="4" Background="#99000000" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True" Width="220" Height="5" Foreground="#E74747" />
        <TextBlock Text="正在读取录制设备…" Foreground="White" FontSize="14" Margin="0,14,0,0" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
