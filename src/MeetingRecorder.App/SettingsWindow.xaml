<Window x:Class="MeetingRecorder.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeetingRecorder · 设置" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Icon="Assets/MeetingRecorder.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F4F6F9">
  <StackPanel Margin="26,22,26,26">
    <Border Background="White" BorderBrush="#E7EAF0" BorderThickness="1" CornerRadius="12" Padding="20">
      <StackPanel>
        <TextBlock Text="录制预览" FontSize="15" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,14" />
        <CheckBox Content="录制时显示低分辨率预览" FontWeight="SemiBold"
                  IsChecked="{Binding PreviewEnabled}" />
        <TextBlock Text="整屏录制且未启用防捕获时，预览画面可能被录进视频。关闭后正在进行的录制立即停止显示预览，下次录制起 Worker 不再发送预览帧。"
                   TextWrapping="Wrap" Foreground="#667085" FontSize="11" Margin="24,6,0,0" />
      </StackPanel>
    </Border>
    <Border Background="White" BorderBrush="#E7EAF0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,14,0,0">
      <StackPanel>
        <TextBlock Text="录制历史" FontSize="15" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,14" />
        <CheckBox Content="记住我的删除选择" FontWeight="SemiBold"
                  IsChecked="{Binding RememberHistoryDeleteChoice}" />
        <TextBlock Text="{Binding RememberedDeleteChoiceText}" TextWrapping="Wrap"
                   Foreground="#667085" FontSize="11" Margin="24,6,0,0" />
      </StackPanel>
    </Border>
    <TextBlock Text="所有设置即改即存，无需手动保存。" Foreground="#98A2B3" FontSize="11" Margin="2,14,0,0" />
  </StackPanel>
</Window>
